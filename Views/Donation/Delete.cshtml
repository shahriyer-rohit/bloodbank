@model BloodBankDB.EF.Tables.Donation

@{
    ViewData["Title"] = "Delete Donation";
}

<h2>Delete Donation</h2>

<h4 class="text-danger">
    Are you sure you want to delete this donation?
</h4>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Donation ID
    </dt>

    <dd class="col-sm-9">
        @Model.DonationId
    </dd>

    <dt class="col-sm-3">
        Donor Name
    </dt>

    <dd class="col-sm-9">
        @Model.Donor.FullName
    </dd>

    <dt class="col-sm-3">
        Donation Date
    </dt>

    <dd class="col-sm-9">
        @Model.DonationDate.ToString("yyyy-MM-dd")
    </dd>

    <dt class="col-sm-3">
        Volume (ml)
    </dt>

    <dd class="col-sm-9">
        @Model.VolumeMl
    </dd>

    <dt class="col-sm-3">
        Camp Name
    </dt>

    <dd class="col-sm-9">
        @Model.CampName
    </dd>

</dl>

<form method="post" action="/Donation/Delete/@Model.DonationId">

    @Html.AntiForgeryToken()

    <input type="hidden" name="DonationId" id="DonationId" value="@Model.DonationId" />

    <input type="submit"
           value="Delete"
           class="btn btn-danger" />

    <a href="/Donation/Index"
       class="btn btn-secondary">

        Back to List

    </a>

</form>

